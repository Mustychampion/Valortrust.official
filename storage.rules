rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Blog images — anyone can read, only authenticated admin can upload/delete
    match /blog-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Portfolio images — anyone can read, only authenticated admin can upload/delete
    match /portfolio-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Testimonial photos — anyone can read, only authenticated admin can upload/delete
    match /testimonial-photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
