rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Checks if request is from the single authorized admin UID
    // Replace "YOUR_SINGLE_USER_UID" with your actual Firebase Auth User UID if restricting admin access to one specific UID
    function isAdmin() {
     return request.auth != null && request.auth.uid == "gtrrfog7tlTyUbKL2cr7deBfOgu1";

    }

    // -----------------------------------------------------------------------
    // PUBLIC READ-ONLY COLLECTIONS (Blog, Portfolio, Testimonials, Sectors, etc.)
    // -----------------------------------------------------------------------
    match /blog_posts/{docId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /portfolio/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /testimonials/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /sectors/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /profiles/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /site_bio/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /skills/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // PUBLIC SUBMISSION COLLECTIONS (Enquiries, Subscribers, Contact, Visitor Logs)
    // -----------------------------------------------------------------------
    match /enquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /subscribers/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /contact_submissions/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /visitor_logs/{docId} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }
  }
}
